# Python
__pycache__/
*.py[cod]

# ---- PyInstaller 产物（全部收拢在 pyinst/ 下）----
# pyinst/*.spec 是源文件、要入库；下面这些是生成物，不入库
pyinst/build/
pyinst/build_*/
pyinst/dist/
pyinst/dist_*/
pyinst/dist_tools/

# 分发包（本地打包后自行上传 Release）
KARDS.zip
KARDS_SimpleVersion-Setup.zip
SHA256SUMS.txt

# ---- 运行时状态与日志 ----
logs/
*.log
settings.json
accounts.json
session.json
currency.json
kards_server.db*

# 自组卡组（玩家数据）
decks/
decks_*/

# ---- 工作区元数据 ----
.workbuddy/
debug/shots/

# PyInstaller 默认工作目录（兜底）
build/
quests.json
shop.json

# 曲库：散装音乐与音乐包 zip 都不入库（见 kards_musicpack / debug/pack_music.py）
assets/music/
assets/musicpack/*.zip

# Github Push 相关文件
*.gp_push
.gp_push

# 自定义 UI 模板（用户数据，见 kards_theme.py）
themes/
hall_familiar.json
# Java/Android 工程
debug/java_cli/build/
debug/java_cli/stub_build/
debug/java_cli/app_build/
android/.gradle/
android/build/
android/app/build/
android/local.properties

# 本地编译产物与 WorkBuddy 会话文件
debug/java_cli/out/
.wbapp_*.genie
